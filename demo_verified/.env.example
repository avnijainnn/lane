# copy to .env; never commit secrets
DATABASE_URL=postgresql+psycopg://lane:lane_local_only@db:5432/lane
APP_TOKEN=replace_with_a_long_random_secret
DASHBOARD_USER=lane
DASHBOARD_PASSWORD=replace_with_a_different_long_random_secret
DEMO_MODE=true
RETELL_API_KEY=
# HighLevel private integration/sub-account token, read-only scopes ONLY.
HIGHLEVEL_TOKEN=
HIGHLEVEL_VERSION=v3
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4o-mini
# GroqCloud free-tier model (obtain your key from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b

# Dataset/demo-only extraction: rules, groq, groq_guarded, groq_events (experimental typed events), or openai.
DEMO_EXTRACTION_BACKEND=rules
EXTRACTION_BACKEND=groq

# Gemini API (Google AI Studio key; model availability depends on project)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# For live browser form POSTs explicitly list trusted origins, e.g. HTTPS reverse proxy URL
LANE_ALLOWED_ORIGINS=
# Live registration stays disabled unless this explicit risky pilot opt-in is set
LANE_ALLOW_SINGLE_WORKSPACE_LIVE=no
